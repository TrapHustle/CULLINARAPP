// Schéma de données — Application de vote pour concours culinaire
// Voir §3 du cahier des charges.
//
// Les champs « énumérés » (VotingTable.type) sont stockés en String et validés
// par zod côté API, plutôt qu'en enum PostgreSQL : cela évite une migration de
// schéma le jour où un nouveau type de table apparaît.

generator client {
  provider = "prisma-client-js"
}

// L'URL de la datasource est définie dans `prisma.config.ts` (Prisma 7).
datasource db {
  provider = "postgresql"
}

model Candidate {
  id       String  @id @default(cuid())
  name     String
  photoUrl String?
  order    Int     @default(0)

  /// Ville d'origine, affichée sous le nom sur la page de vote du public.
  city String?

  /// Nombre de votes publics provenant du scrutin externe affiché au classement.
  /// Ces votes sont comptés séparément des notes des jurés et ne modifient pas
  /// la note moyenne sur 75.
  ///
  /// Les votes payés sur la page `/voter` s'y ajoutent sans le modifier : ils
  /// vivent dans `PublicVotePayment`, ce champ garde les votes importés.
  publicVoteCount Int @default(0)

  /// Date de la première ouverture des votes pour ce candidat.
  /// Elle sert à refléter le déroulé du concours, mais ne bloque jamais la
  /// synchronisation : une tablette peut avoir travaillé hors ligne pendant
  /// l'ouverture ou après la fermeture.
  openedAt DateTime?

  votes              Vote[]
  validations        TableValidation[]
  publicVotePayments PublicVotePayment[]

  @@index([order])
}

/// type : "LAMBDA" | "SPECIAL". Un vote issu d'une table SPECIAL pèse double (§4.2).
/// expectedJurors : nombre de jurés attendus à cette table, utilisé pour
/// l'enchaînement des saisies sur la tablette et le suivi d'avancement.
model VotingTable {
  id             String @id @default(cuid())
  name           String
  type           String @default("LAMBDA")
  expectedJurors Int    @default(1)

  /// Tablette actuellement en charge de cette table, ou `null` si libre.
  ///
  /// L'assignation est exclusive : deux tablettes sur la même table feraient
  /// voter deux fois les mêmes jurés sans que rien ne le signale. Le serveur
  /// est seul juge, car lui seul voit toutes les tablettes.
  ///
  /// C'est un identifiant tiré par la tablette à son premier lancement et
  /// conservé localement : il lui permet de retrouver sa table après un
  /// redémarrage, sans quoi une simple coupure de courant immobiliserait la
  /// table jusqu'à la fin du concours.
  assignedDeviceId String?
  assignedAt       DateTime?

  votes       Vote[]
  validations TableValidation[]
}

model Criterion {
  id        String @id @default(cuid())
  name      String
  order     Int    @default(0)
  maxPoints Int    @default(5)

  scores VoteScore[]

  @@index([order])
}

/// Session unique de l'événement (une seule ligne, id fixe "singleton").
///
/// L'événement n'est pas une entité à part : le serveur n'en pilote qu'un à la
/// fois. Son identité (nom, date, affiche) vit donc ici, et la remise à zéro
/// consiste à effacer les votes sans toucher à la configuration.
model Session {
  id                String    @id @default("singleton")
  activeCandidateId String?
  votingOpen        Boolean   @default(false)
  timerEnabled      Boolean   @default(true)
  timerSeconds      Int       @default(30)
  eventName         String?
  eventDate         DateTime?
  /// Chemin servi par ce serveur, de la forme `/api/images/<id>` — jamais une
  /// URL externe : les tablettes doivent pouvoir l'afficher sans internet.
  eventPhotoUrl     String?

  /// Numéro de génération des données, comparé par chaque tablette.
  ///
  /// Le changer ordonne aux tablettes d'effacer leur base locale — votes,
  /// validations, cache et portraits. C'est le seul moyen de repartir propre
  /// sans manipuler chaque tablette une par une, entre une répétition et le
  /// jour J. Les tablettes hors ligne obéissent à leur retour, après avoir
  /// d'abord envoyé ce qu'elles avaient en attente.
  dataGeneration String @default("1")

  /// Part de chaque catégorie dans la note finale, en pourcentage (§4.2).
  ///
  /// Ce n'est pas un poids par vote : c'est la part que pèse la *moyenne* de la
  /// catégorie. « Jury spécial 60 » signifie que l'avis du jury compte pour
  /// 60 % de la note, qu'il soit composé de 3 personnes ou de 15 — ce qu'un
  /// poids par vote ne permet pas de garantir.
  ///
  /// Les deux parts n'ont pas à totaliser 100 : le calcul les renormalise, y
  /// compris lorsqu'une catégorie n'a pas encore voté.
  sharePublic  Float @default(20)
  shareSpecial Float @default(60)

  /// Part du **vote du public en ligne** (payant) dans la note finale, en
  /// pourcentage. Même principe que les deux autres parts : elle porte sur la
  /// note dérivée des voix en ligne, pas sur chaque voix. 20 % par défaut.
  shareOnline Float @default(20)

  /// Bornes de la note brute qu'un juré peut saisir sur un critère.
  /// 1 à 5 par défaut ; élargir jusqu'à 0–10, par exemple, ne change que ces
  /// deux valeurs — le reste du calcul (§4.1, §4.3) suit sans modification.
  scoreMin Int @default(1)
  scoreMax Int @default(5)

  /// Déroulé du vote, réglé séparément pour chaque catégorie de table.
  ///
  /// "BY_CANDIDATE" — l'organisateur ouvre un candidat à la fois, et la
  /// catégorie le note avant de passer au suivant. C'est le déroulé d'origine,
  /// celui d'une dégustation menée au rythme du service.
  ///
  /// "BY_JUROR" — tous les candidats déjà ouverts sont notables en même temps :
  /// chaque juré prend la tablette et les parcourt tous avant de la passer.
  ///
  /// Les deux catégories sont indépendantes : le jury spécial peut tout
  /// déguster puis tout noter pendant que la salle avance plat par plat.
  ///
  /// Stockés en String comme `VotingTable.type`, et pour la même raison : un
  /// troisième déroulé ne devra pas coûter une migration de schéma.
  voteModePublic  String @default("BY_CANDIDATE")
  voteModeSpecial String @default("BY_CANDIDATE")

  /// Vote du public en ligne (page `/voter`), réglé depuis le dashboard.
  ///
  /// Fermé par défaut : la page n'accepte aucun paiement tant que
  /// l'organisateur ne l'a pas ouverte.
  publicVoteOpen       Boolean   @default(false)
  /// Prix d'un vote, en FCFA. Le montant est toujours recalculé par le
  /// serveur : la page n'envoie qu'un nombre de votes.
  publicVotePrice      Int       @default(200)
  /// Fin du vote. `null` : pas d'heure de fin, seul l'interrupteur compte.
  publicVoteClosesAt   DateTime?
  /// Masqués, les compteurs ne quittent jamais le serveur : la page suit
  /// alors l'ordre de passage et ne laisse rien deviner du classement.
  publicVoteShowCounts Boolean   @default(true)
  /// Présentation de la page : "MENU" (Carte du menu, retenue) | "CARTES".
  publicVoteStyle      String    @default("MENU")
  /// Moyens de paiement proposés : "WAVE" | "ORANGE_MONEY" | "MTN" | "CARD".
  /// La carte est en maintenance chez le prestataire : décochée par défaut.
  publicVoteMethods    String[]  @default(["WAVE", "ORANGE_MONEY", "MTN"])
  /// Ligne au-dessus du titre, par exemple « Kabowd Production · 7ᵉ édition ».
  publicVoteTagline    String?
  /// Ligne sous le titre, par exemple « 1ʳᵉ sélection · Bouaké ».
  publicVoteSubtitle   String?
}

/// Paiement d'un lot de votes du public, pour un seul candidat.
///
/// Un vote n'existe qu'à travers son paiement : il compte quand le paiement
/// est confirmé (`status` = "CONFIRMED"), jamais avant. Une même personne peut
/// payer autant de lots qu'elle le souhaite.
///
/// Le nom du candidat est recopié à l'enregistrement : un paiement reste une
/// trace comptable, il survit à la suppression du candidat (le lien passe
/// alors à `null`).
model PublicVotePayment {
  id                String  @id @default(cuid())
  /// Référence remise au votant, de la forme « VP-9NF24H ».
  reference         String  @unique
  candidateId       String?
  candidateName     String
  votes             Int
  /// Prix d'un vote au moment du paiement, en FCFA.
  unitPrice         Int
  /// `votes × unitPrice`, calculé par le serveur.
  amount            Int
  /// "WAVE" | "ORANGE_MONEY" | "MTN" | "CARD".
  method            String
  /// Numéro débité, 10 chiffres. Jamais renvoyé à la page publique.
  phone             String?
  /// "PENDING" | "CONFIRMED" | "FAILED".
  status            String  @default("PENDING")
  /// Paiement simulé (aucun prestataire branché) : il s'affiche sur la page
  /// publique mais n'entre jamais dans les résultats officiels.
  simulated         Boolean @default(false)
  /// Identifiant de la transaction chez le prestataire de paiement.
  providerReference String?

  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@index([candidateId, status])
  @@index([createdAt])
  // Limite anti-abus : demandes récentes pour un même numéro.
  @@index([phone, createdAt])
}

/// Instantané immuable d'un concours clos. Le scrutin actif reste volontairement
/// séparé : l'organisateur peut préparer le suivant sans modifier son historique.
model VoteEventArchive {
  id        String   @id @default(cuid())
  name      String
  eventDate DateTime
  closedAt  DateTime @default(now())
  snapshot  Json

  @@index([eventDate])
  @@index([closedAt])
}

/// Demande de virement de la part de l'organisateur vers son numéro mobile.
///
/// Le statut suit : "PENDING" (reçue, à traiter) → "PAID" (virée) ou
/// "REJECTED" (refusée, avec une note explicative).
model WithdrawalRequest {
  id          String    @id @default(cuid())
  /// Montant demandé, en FCFA.
  amount      Int
  /// Numéro mobile de réception (10 chiffres).
  phone       String
  /// Moyen de paiement choisi : "WAVE" | "ORANGE_MONEY" | "MTN".
  method      String
  /// Note libre de l'organisateur (optionnelle).
  note        String?
  /// "PENDING" | "PAID" | "REJECTED"
  status      String    @default("PENDING")
  /// Réponse ou note de traitement (remplie côté admin lors du traitement).
  adminNote   String?
  /// Date d'envoi du mail d'alerte. `null` quand l'envoi a échoué ou qu'aucun
  /// compte SMTP n'est configuré : la demande reste valable, mais l'écran
  /// d'administration peut prévenir que personne n'a été alerté.
  notifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([status, createdAt])
}

/// Image téléversée depuis le dashboard (affiche de l'événement, portrait d'un
/// candidat), stockée en base et servie par `/api/images/<id>`.
///
/// Les octets vivent en base plutôt que sur le disque : c'est la seule façon de
/// servir les mêmes images en mode hébergé (le disque de Vercel est éphémère et
/// perdrait les fichiers à chaque redéploiement) ET en réseau local sans
/// internet, sans dépendre d'un service de stockage externe.
model Image {
  id        String   @id @default(cuid())
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())

  /// Organisation propriétaire (SaaS). `null` seulement le temps de la
  /// migration : les images existantes sont rattachées à Kabowd Production.
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// id : UUID v4 **généré par la tablette**. C'est la clé de l'idempotence de
/// la synchronisation (§11) — un upsert sur cet id ne crée jamais de doublon.
///
/// Le poids du vote n'est PAS stocké ici : il est dérivé du type de la table
/// au moment du calcul, afin qu'une tablette ne puisse jamais l'influencer (§0.3).
model Vote {
  id          String   @id
  tableId     String
  candidateId String
  jurorIndex  Int
  createdAt   DateTime
  syncedAt    DateTime @default(now())

  table     VotingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  candidate Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  scores    VoteScore[]

  @@unique([tableId, candidateId, jurorIndex])
  @@index([candidateId])
  @@index([tableId])
}

/// rawValue : note brute de 1 à 5 saisie par le juré (0 si le critère n'a pas
/// été noté avant l'expiration du chronomètre, cf. §11).
/// La conversion ×2 vers une note /10 est faite par le moteur de calcul, jamais ici.
model VoteScore {
  id          String @id @default(cuid())
  voteId      String
  criterionId String
  rawValue    Int

  vote      Vote      @relation(fields: [voteId], references: [id], onDelete: Cascade)
  criterion Criterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)

  @@unique([voteId, criterionId])
}

/// Verrouillage des votes d'une table pour un candidat donné (§5, étape 5).
model TableValidation {
  id          String   @id @default(cuid())
  tableId     String
  candidateId String
  validatedAt DateTime @default(now())

  table     VotingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  candidate Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([tableId, candidateId])
}

// ============================================================================
// SaaS — modèle multi-organisations
// ============================================================================
//
// Voir `docs/modele-de-donnees.md` et `docs/regles-de-gestion.md` dans le dépôt
// parent. Ces tables cohabitent avec les anciennes le temps de la bascule :
// la migration `20261013120000_saas_modele` les remplit à partir des données
// existantes, sans rien supprimer. Les anciennes tables ne seront retirées
// qu'une fois la nouvelle version validée en production.
//
// Comme pour l'ancien schéma, les valeurs énumérées (rôle, état, canal…) sont
// stockées en texte : une nouvelle valeur ne coûte pas de migration.

/// Le client de la plateforme (RG 0.1). Toute donnée lui appartient.
model Organisation {
  id               String   @id @default(cuid())
  nom              String
  logoUrl          String?
  /// Identifiants de la passerelle de paiement propres au client (RG 0.5).
  paiementConfig   Json?
  /// Part reversée à l'organisateur sur les votes payés, en pourcentage.
  partOrganisateur Float    @default(90)
  creeLe           DateTime @default(now())

  utilisateurs    Utilisateur[]
  evenements      Evenement[]
  candidats       Candidat[]
  images          Image[]
  demandesRetrait DemandeRetrait[]
  paiements       Paiement[]
  archives        ArchiveSelection[]
}

/// RG 0.3 et 0.4. Un utilisateur appartient à une seule organisation.
model Utilisateur {
  id             String   @id @default(cuid())
  organisationId String
  email          String   @unique
  motDePasseHash String
  /// "PROPRIETAIRE" | "ORGANISATEUR" | "JURY" | "LECTURE"
  role           String   @default("ORGANISATEUR")
  creeLe         DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// RG 1.1. L'édition est un attribut, pas une entité.
model Evenement {
  id             String    @id @default(cuid())
  organisationId String
  nom            String
  edition        Int?
  /// Ligne au-dessus du titre, par exemple « Kabowd Production · 7ᵉ édition ».
  sousTitre      String?
  date           DateTime?
  /// `/api/images/<id>`, comme aujourd'hui : servi par ce serveur.
  afficheUrl     String?
  creeLe         DateTime  @default(now())

  organisation Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  selections   Selection[]
  typesModeles TypeVoteModele[]

  @@index([organisationId])
}

/// RG 1.2 à 1.5. Porte les réglages qui vivaient sur la ligne `Session`.
model Selection {
  id          String    @id @default(cuid())
  evenementId String
  /// 1, 2… La finale est la dernière (RG 1.3).
  rang        Int       @default(1)
  /// Par exemple « 1ʳᵉ sélection · Bouaké ».
  libelle     String
  lieu        String?
  debut       DateTime?
  /// Fin du vote en ligne (RG 7.2). `null` : seul l'interrupteur compte.
  fin         DateTime?
  /// "PREPAREE" | "OUVERTE" | "CLOTUREE"
  etat        String    @default("PREPAREE")
  nbQualifies Int       @default(0)
  /// Lien public de vote (RG 7.1).
  slug        String    @unique

  // --- Vote en ligne ---
  voteEnLigneOuvert Boolean  @default(false)
  /// Prix d'une voix, en FCFA (RG 4.4).
  prixVote          Int      @default(200)
  /// Une voix gratuite par personne identifiée (RG 7.4).
  voixGratuite      Boolean  @default(false)
  /// "A" (part relative) | "B" (paliers) | "C" (par leader) — RG 8.3.
  modeEnLigne       String   @default("A")
  compteursVisibles Boolean  @default(true)
  /// "MENU" | "CARTES"
  stylePage         String   @default("MENU")
  moyensPaiement    String[] @default(["WAVE", "ORANGE_MONEY", "MTN"])

  // --- Vote en salle (tablettes) ---
  voteSalleOuvert       Boolean @default(false)
  /// Candidat en cours de dégustation. Pas de relation : elle bouclerait avec
  /// `Participation`, et une valeur périmée ne doit rien casser.
  participationActiveId String?
  chronoActif           Boolean @default(true)
  chronoSecondes        Int     @default(30)
  /// Bornes des notes proposées au juré sur la tablette.
  noteMin               Int     @default(1)
  noteMax               Int     @default(5)
  /// Le changer ordonne aux tablettes d'effacer leurs données locales.
  generationDonnees     String  @default("1")

  creeLe DateTime @default(now())

  evenement      Evenement          @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  typesVote      TypeVote[]
  paliers        Palier[]
  participations Participation[]
  votants        Votant[]
  paiements      Paiement[]
  tables         TableJury[]
  archives       ArchiveSelection[]

  @@index([evenementId, rang])
}

/// Palier du mode B : `points` (sur 100) atteints à `voixMax` voix. Entre deux
/// plafonds, la note suit la règle de trois (RG 8.3).
model Palier {
  id          String @id @default(cuid())
  selectionId String
  voixMax     Int
  points      Float
  ordre       Int    @default(0)

  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId])
}

/// Grille de notation de référence, au niveau de l'événement (RG 3.1). Copiée
/// dans chaque nouvelle sélection (RG 3.2).
model TypeVoteModele {
  id           String  @id @default(cuid())
  evenementId  String
  libelle      String
  /// "SALLE" | "EN_LIGNE"
  canal        String
  payant       Boolean @default(false)
  avecCriteres Boolean @default(true)
  part         Float   @default(0)
  /// "BY_CANDIDATE" | "BY_JUROR"
  deroule      String  @default("BY_CANDIDATE")
  ordre        Int     @default(0)

  evenement Evenement       @relation(fields: [evenementId], references: [id], onDelete: Cascade)
  criteres  CritereModele[]

  @@index([evenementId])
}

model CritereModele {
  id         String @id @default(cuid())
  typeVoteId String
  libelle    String
  ordre      Int    @default(0)
  bareme     Int    @default(5)

  typeVote TypeVoteModele @relation(fields: [typeVoteId], references: [id], onDelete: Cascade)

  @@index([typeVoteId])
}

/// Type de vote d'une sélection (RG 4.1). Remplace les catégories figées
/// LAMBDA / SPECIAL / ONLINE de l'ancien moteur.
model TypeVote {
  id           String  @id @default(cuid())
  selectionId  String
  libelle      String
  /// "SALLE" | "EN_LIGNE"
  canal        String
  payant       Boolean @default(false)
  /// RG 4.2 : sans critère, on compte des voix ; avec, on note.
  avecCriteres Boolean @default(true)
  /// Part dans la note finale, en pourcentage (RG 4.5).
  part         Float   @default(0)
  /// "BY_CANDIDATE" | "BY_JUROR" — déroulé sur les tablettes.
  deroule      String  @default("BY_CANDIDATE")
  ordre        Int     @default(0)

  selection Selection   @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  criteres  Critere[]
  suffrages Suffrage[]
  tables    TableJury[]

  @@index([selectionId])
}

/// RG 3.4. Le barème est la note maximale du critère.
model Critere {
  id         String @id @default(cuid())
  typeVoteId String
  libelle    String
  ordre      Int    @default(0)
  bareme     Int    @default(5)

  typeVote TypeVote @relation(fields: [typeVoteId], references: [id], onDelete: Cascade)
  valeurs  Valeur[]

  @@index([typeVoteId])
}

/// RG 2.1. Appartient à l'organisation : il peut revenir d'une édition à l'autre.
model Candidat {
  id             String  @id @default(cuid())
  organisationId String
  nom            String
  ville          String?
  photoUrl       String?

  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  participations Participation[]

  @@index([organisationId])
}

/// « Ce candidat, dans cette sélection » (RG 2.2). Tous les votes s'y rattachent.
model Participation {
  id          String    @id @default(cuid())
  selectionId String
  candidatId  String
  /// Ordre de passage.
  ordre       Int       @default(0)
  /// Disponibilité au vote (RG 2.4).
  disponible  Boolean   @default(true)
  ouverteLe   DateTime?
  /// Qualification enregistrée, pas déduite (RG 9.2).
  qualifie    Boolean   @default(false)

  selection   Selection         @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  candidat    Candidat          @relation(fields: [candidatId], references: [id], onDelete: Restrict)
  suffrages   Suffrage[]
  paiements   Paiement[]
  validations ValidationTable[]

  @@unique([selectionId, candidatId])
  @@index([selectionId, ordre])
}

/// Le VOTE des règles de gestion : une seule table pour les tablettes, les
/// voix payées, gratuites et importées (RG 5.3). Nommé « suffrage » pour
/// cohabiter avec l'ancienne table `Vote` pendant la bascule.
model Suffrage {
  /// Pour une tablette : l'UUID qu'elle a tiré, gage d'idempotence. Les votes
  /// migrés gardent leur identifiant, sinon les tablettes les renverraient.
  id              String    @id
  participationId String
  typeVoteId      String
  /// Nombre de voix représentées (RG 5.4).
  poids           Int       @default(1)
  /// "TABLETTE" | "PAIEMENT" | "GRATUIT" | "IMPORT"
  origine         String
  tableId         String?
  jureIndex       Int?
  paiementId      String?   @unique
  votantId        String?   @unique
  creeLe          DateTime  @default(now())
  synchroLe       DateTime  @default(now())
  /// Un vote ne se modifie pas : on l'annule (RG 5.7).
  annuleLe        DateTime?

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Restrict)
  typeVote      TypeVote      @relation(fields: [typeVoteId], references: [id], onDelete: Restrict)
  table         TableJury?    @relation(fields: [tableId], references: [id], onDelete: SetNull)
  paiement      Paiement?     @relation(fields: [paiementId], references: [id], onDelete: Restrict)
  votant        Votant?       @relation(fields: [votantId], references: [id], onDelete: Restrict)
  valeurs       Valeur[]

  @@unique([tableId, participationId, jureIndex])
  @@index([participationId, typeVoteId])
}

/// La note donnée sur un critère, bornée par son barème (RG 5.5).
model Valeur {
  id         String @id @default(cuid())
  suffrageId String
  critereId  String
  valeur     Int

  suffrage Suffrage @relation(fields: [suffrageId], references: [id], onDelete: Cascade)
  critere  Critere  @relation(fields: [critereId], references: [id], onDelete: Restrict)

  @@unique([suffrageId, critereId])
}

/// Personne identifiée pour la voix gratuite (RG 7.4) : une seule par sélection.
model Votant {
  id          String   @id @default(cuid())
  selectionId String
  /// Numéro de téléphone, sans code de confirmation (risque accepté).
  identifiant String
  creeLe      DateTime @default(now())

  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  suffrage  Suffrage?

  @@unique([selectionId, identifiant])
}

/// Paiement d'un lot de voix (RG 6). Trace comptable : il survit à la
/// suppression du candidat, dont le nom reste recopié (RG 6.7).
model Paiement {
  id              String    @id @default(cuid())
  organisationId  String
  selectionId     String?
  participationId String?
  reference       String    @unique
  candidatNom     String
  voix            Int
  prixUnitaire    Int
  montant         Int
  /// "WAVE" | "ORANGE_MONEY" | "MTN" | "CARD"
  moyen           String
  telephone       String?
  /// "PENDING" | "CONFIRMED" | "FAILED"
  statut          String    @default("PENDING")
  /// Simulé : affiché sur la page publique, jamais dans les résultats officiels.
  simule          Boolean   @default(false)
  refPrestataire  String?
  creeLe          DateTime  @default(now())
  confirmeLe      DateTime?

  organisation  Organisation   @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  selection     Selection?     @relation(fields: [selectionId], references: [id], onDelete: SetNull)
  participation Participation? @relation(fields: [participationId], references: [id], onDelete: SetNull)
  suffrage      Suffrage?

  @@index([participationId, statut])
  @@index([creeLe])
  @@index([telephone, creeLe])
}

/// Table de jury et sa tablette. Hors du modèle métier, mais indispensable à
/// l'application (ancienne `VotingTable`).
model TableJury {
  id            String    @id @default(cuid())
  selectionId   String
  typeVoteId    String
  nom           String
  juresAttendus Int       @default(1)
  /// Tablette en charge de la table : assignation exclusive.
  deviceId      String?
  assigneeLe    DateTime?

  selection   Selection         @relation(fields: [selectionId], references: [id], onDelete: Cascade)
  typeVote    TypeVote          @relation(fields: [typeVoteId], references: [id], onDelete: Restrict)
  suffrages   Suffrage[]
  validations ValidationTable[]

  @@index([selectionId])
}

/// Verrouillage des votes d'une table pour une participation.
model ValidationTable {
  id              String   @id @default(cuid())
  tableId         String
  participationId String
  valideeLe       DateTime @default(now())

  table         TableJury     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  @@unique([tableId, participationId])
}

/// Résultat figé à la clôture (RG 9.5).
model ArchiveSelection {
  id             String   @id @default(cuid())
  organisationId String
  selectionId    String?
  nom            String
  date           DateTime
  clotureLe      DateTime @default(now())
  snapshot       Json

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  selection    Selection?   @relation(fields: [selectionId], references: [id], onDelete: SetNull)

  @@index([organisationId, clotureLe])
}

/// Demande de virement de la part de l'organisateur (ancienne `WithdrawalRequest`).
model DemandeRetrait {
  id             String    @id @default(cuid())
  organisationId String
  montant        Int
  telephone      String
  /// "WAVE" | "ORANGE_MONEY" | "MTN"
  moyen          String
  note           String?
  /// "PENDING" | "PAID" | "REJECTED"
  statut         String    @default("PENDING")
  noteAdmin      String?
  notifieLe      DateTime?
  creeLe         DateTime  @default(now())
  traiteeLe      DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict)

  @@index([organisationId, statut, creeLe])
}
